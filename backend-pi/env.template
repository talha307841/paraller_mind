# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — only this one key is mandatory
# ─────────────────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE

# ─────────────────────────────────────────────────────────────────────────────
# NVIDIA NIM model (free tier — pick any from build.nvidia.com)
# ─────────────────────────────────────────────────────────────────────────────
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_MAX_TOKENS=1024
NVIDIA_TEMPERATURE=0.6

# ─────────────────────────────────────────────────────────────────────────────
# FALLBACK APIs (all optional — leave empty to skip that backend)
# ─────────────────────────────────────────────────────────────────────────────
# Groq — 14,400 req/day free — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# Google Gemini Flash — free tier — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# GitHub Models — 45+ models free — needs a GitHub PAT with models:read scope
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────────────
# AUDIO
# ─────────────────────────────────────────────────────────────────────────────
# Run: python -c "import pyaudio; p=pyaudio.PyAudio(); [print(i,p.get_device_info_by_index(i)['name']) for i in range(p.get_device_count())]"
# to list devices. -1 = system default.
AUDIO_DEVICE_INDEX=-1

# VAD sensitivity: 0.3=loose (noisy rooms), 0.7=strict (quiet room)
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=800

# ─────────────────────────────────────────────────────────────────────────────
# STT — faster-whisper
# ─────────────────────────────────────────────────────────────────────────────
# Sizes: tiny, base, small, medium — base is the sweet spot on Pi 5
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1

# ─────────────────────────────────────────────────────────────────────────────
# MEMORY
# ─────────────────────────────────────────────────────────────────────────────
DATA_DIR=~/.parallel_mind
EMBEDDING_MODEL=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
RAG_TOP_K=5

# ─────────────────────────────────────────────────────────────────────────────
# TTS — Piper
# ─────────────────────────────────────────────────────────────────────────────
# Run setup.sh to download the voice model files.
PIPER_VOICE=en_US-lessac-medium

# ─────────────────────────────────────────────────────────────────────────────
# WAKE WORDS & QUERY
# ─────────────────────────────────────────────────────────────────────────────
WAKE_WORDS=hey memory,ok memory,parallel mind
QUERY_TIMEOUT_SECONDS=10.0

# ─────────────────────────────────────────────────────────────────────────────
# PROACTIVE ASSIST
# ─────────────────────────────────────────────────────────────────────────────
PROACTIVE_KEYWORDS=meeting,client,project,deadline,presentation,interview,standup,demo
PROACTIVE_LOOKBACK_HOURS=48
PROACTIVE_DEBOUNCE_SECONDS=300

# ─────────────────────────────────────────────────────────────────────────────
# API SERVER (ESP32 + dashboard)
# ─────────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8765
# Optional bearer token. Leave empty to disable auth (trusted LAN use).
API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# GPIO MUTE BUTTON (Raspberry Pi only)
# ─────────────────────────────────────────────────────────────────────────────
# Wire a momentary push-button between BCM pin 17 and GND.
GPIO_ENABLED=false
MUTE_GPIO_PIN=17
